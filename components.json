      "declared": {
        "the_component_name_is_not_the_binary_name": {
          "value": "tokenfuse",
          "why": "The binary is `tokenfuse`; every launcher installs it as `tokenfuse-gateway`, which is the name estate.json and the port map use. Recorded rather than renamed: the rename would break every deployment for a tidiness nobody asked for."
        },
        "the_mcp_surface_is_a_second_listener": {
          "value": "127.0.0.1:4200",
          "why": "The same binary serves an MCP surface on its own address from TOKENFUSE_MCP_ADDR. One component, two listeners, which this schema has no field for and which is not worth inventing one for until a second component needs it."
        }
      }
    },
    {
      "name": "focus-export",
