        "crate": "tokenfuse-gateway",
        "workspace": ".",
        "subcommand": "focus-export"
      },
      "declared": {
        "it_is_a_routine_not_a_binary": {
          "value": "tokenfuse focus-export --traces <dir> --out <file.csv>",
          "why": "estate.json lists it beside two binaries and it is a subcommand of one of them. stack-up runs it at 06:00 against its own trace directory."
        }
